{
  "name": "emc-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/bundle-report.mjs",
    "seo:assets": "node scripts/generate-og-image.mjs && node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/react": "^10.69.0",
    "axios": "^1.15.2",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.38.0",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "laravel-echo": "^2.4.0",
    "libphonenumber-js": "^1.13.6",
    "lucide-react": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "pusher-js": "^8.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.12",
    "sharp": "^0.35.3",
    "svgo": "^4.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
