/*
 * M7.b — full `strict: true` across the app (end state the plan set in M4.b).
 *
 * History: M4.b enabled strictNullChecks on lib/hooks/i18n/api/types; the M0 typing
 * pass (real types for the team merge) had already made the rest compliant — probing
 * `strict: true` over all of src in M7 produced ZERO errors, verified non-vacuous by
 * planting a `string = null` (caught: TS2322) and removing it. Kept as a separate
 * project so `npm run build` stays the fast, unchanged gate; this runs as its own CI
 * step (`npm run typecheck:strict`).
 */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.strict.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"]
}
