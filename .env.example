# Copy this file to .env and fill in the values for your environment.
# .env is excluded from git — never commit real values.

# ─── API ─────────────────────────────────────────────────────────────────────
# Preferred: Laravel API base (must include /api)
VITE_API_URL=http://127.0.0.1:8000/api

# Fallback if VITE_API_URL is unset (axios reads both)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ─── App ─────────────────────────────────────────────────────────────────────
# Optional: set to "production" in production builds
VITE_APP_ENV=production

# ─── Error Tracking (Sentry) ─────────────────────────────────────────────────
# Optional — if set, Sentry is initialized automatically.
# Install: npm install @sentry/react
# Then set this DSN from your Sentry project settings.
VITE_SENTRY_DSN=

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Optional: enable module ↑↓ reorder (requires POST …/modules/reorder on API)
# VITE_LMS_MODULE_REORDER=true

# ─── Analytics & Marketing (loaded only after cookie consent) ────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=

# ─── Community ────────────────────────────────────────────────────────────────
# WhatsApp community link shown after successful course enrollment.
# Leave empty to hide the WhatsApp block entirely.
VITE_WHATSAPP_COMMUNITY_URL=
