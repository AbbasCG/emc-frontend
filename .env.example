# Copy this file to .env and fill in the values for your environment.
# .env is excluded from git — never commit real values.

# Preferred: Laravel API base (must include /api)
VITE_API_URL=http://127.0.0.1:8000/api

# Fallback if VITE_API_URL is unset (axios reads both)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: enable module ↑↓ reorder (requires POST …/modules/reorder on API)
# VITE_LMS_MODULE_REORDER=true

